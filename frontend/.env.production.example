# Production template. Vite bakes these into the built JS at `npm run build`
# time (they are NOT read at runtime), so set them before building; changing a
# value means rebuilding.
VITE_APP_NAME="DICTIS"
# Single origin: the SPA's own HTTPS origin. nginx (docker/default.conf.template)
# proxies /api, /sanctum and /storage to the backend from here. Must equal the
# backend's FRONTEND_URL and APP_URL.
VITE_API_URL=https://dictis.example.gov.ph
# Your own reCAPTCHA v3 site key, paired with the backend's RECAPTCHA_SECRET_KEY.
VITE_RECAPTCHA_SITE_KEY=your-production-site-key

APP_NAME="DepEd Division ICT Inventory System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Origin of the React SPA (frontend/). The only origin CORS allows (config/cors.php).
FRONTEND_URL=http://localhost:5173
# host:port of the SPA that gets cookie-based (stateful) Sanctum auth. Must match FRONTEND_URL.
SANCTUM_STATEFUL_DOMAINS=localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Level for the `security` channel (storage/logs/security-YYYY-MM-DD.log), independent of
# LOG_LEVEL so info-level auth events survive a quieter LOG_LEVEL.
SECURITY_LOG_LEVEL=info

# Local dev runs on MySQL via XAMPP (create the `inventory` database first).
# Tests ignore this and use in-memory SQLite (phpunit.xml).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inventory
DB_USERNAME=root
DB_PASSWORD=

# External user authentication database (read-only)
# Authenticate users against an external database while managing roles/permissions locally
# Leave at mysql; phpunit.xml switches it to sqlite so tests never dial PRIME.
EXTERNAL_DB_DRIVER=mysql
EXTERNAL_DB_HOST=127.0.0.1
EXTERNAL_DB_PORT=3306
EXTERNAL_DB_DATABASE=external_users_db
EXTERNAL_DB_USERNAME=readonly_user
EXTERNAL_DB_PASSWORD=readonly_password

# App-side slow query log threshold in ms (0 = off). Optional: MySQL's own
# slow log path if it isn't one of the defaults Settings > System logs checks.
DB_SLOW_QUERY_MS=1000
# DB_SLOW_QUERY_LOG_FILE=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Cookie domain shared by the API and the SPA. Use the parent domain in production.
SESSION_DOMAIN=localhost
# Must be true in production (HTTPS) so session cookies are never sent over plain HTTP.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Set MAIL_MAILER=resend and a key from resend.com to send real email;
# MAIL_FROM_ADDRESS must use a domain verified in Resend.
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Google's test key below passes every request. It works for local development
# only; production refuses it, so set your own v3 secret key there.
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# Set only when a reverse proxy or load balancer sits in front of PHP
# (comma-separated IPs/CIDRs, or * if nothing else can reach the app).
TRUSTED_PROXIES=
# X-Forwarded-* headers trusted from those proxies (for,host,port,proto,prefix).
# Add one only if the proxy always overwrites it: a client-supplied Host or
# Proto would otherwise poison generated URLs.
TRUSTED_PROXY_HEADERS=for

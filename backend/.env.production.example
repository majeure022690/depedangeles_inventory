# Production template. Copy to `.env` on the production server, fill in every
# placeholder, then run `php artisan key:generate` if APP_KEY is still blank.
# Never commit the filled-in `.env` (backend/.gitignore already excludes it).
#
# Every value below either differs from `.env.example` (the local dev
# template) on purpose, or is a placeholder only this file adds. Anything not
# listed here (APP_LOCALE, BCRYPT_ROUNDS, etc.) is fine to keep as
# `.env.example` already has it; copy the rest across unchanged.

APP_NAME="DepEd Division ICT Inventory System"
APP_ENV=production
APP_KEY=
# Never true in production: it would leak stack traces to clients.
APP_DEBUG=false
# Single origin: the SPA's nginx (frontend/docker/default.conf.template) proxies
# /api, /sanctum and /storage to this backend, so APP_URL is the SPA origin too.
# QR labels (route('equipment.edit')) and avatar /storage URLs are built from it.
APP_URL=https://dictis.example.gov.ph
# HTTPS origin of the SPA. The only origin CORS allows, the password-reset link
# target, and the hostname reCAPTCHA tokens must come from.
FRONTEND_URL=https://dictis.example.gov.ph
# Bare hostname(s) of the SPA, comma-separated if served from more than one
# domain. Must match FRONTEND_URL's host.
SANCTUM_STATEFUL_DOMAINS=dictis.example.gov.ph
# Cookie domain for the session, XSRF and trusted-device (2FA) cookies, which
# all reuse session.domain. Leave empty for host-only cookies (preferred with a
# single origin), or set the SPA hostname exactly. Never a parent domain like
# .example.gov.ph: that would send them to every sibling subdomain.
SESSION_DOMAIN=
# HTTPS only: session and XSRF cookies are never sent over plain HTTP.
SESSION_SECURE_COOKIE=true

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=notice
# Level for the dedicated `security` channel (storage/logs/security.log), kept
# separate from LOG_LEVEL so login/2FA/lockout events logged at info are not
# dropped by the quieter production LOG_LEVEL.
SECURITY_LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inventory
DB_USERNAME=inventory_app
DB_PASSWORD=

# PRIME user database (read-only source of user accounts).
EXTERNAL_DB_HOST=
EXTERNAL_DB_PORT=3306
EXTERNAL_DB_DATABASE=
EXTERNAL_DB_USERNAME=
EXTERNAL_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

FILESYSTEM_DISK=local
# No code dispatches a queued job yet, so a queue worker is not required.
QUEUE_CONNECTION=database

CACHE_STORE=database

# A real mailer is required: password-reset mail goes nowhere with MAIL_MAILER=log.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.gov.ph"
MAIL_FROM_NAME="${APP_NAME}"

# Or MAIL_MAILER=resend with a key from resend.com; MAIL_FROM_ADDRESS must use
# a domain verified in Resend.
RESEND_API_KEY=

# Your own reCAPTCHA v3 secret. Blank or Google's test secret fails closed in
# production (App\Rules\Recaptcha::TEST_SECRET_KEY). Pair it with the matching
# VITE_RECAPTCHA_SITE_KEY in frontend/.env.production.
RECAPTCHA_SECRET_KEY=

# Comma-separated IPs/CIDRs of the proxies in front of PHP, so HTTPS and the
# real client IP are detected correctly. List exactly the SPA nginx container
# (or its Docker network CIDR) plus any TLS load balancer in front of it.
# NEVER set this to `*`: nginx appends to the client-supplied X-Forwarded-For,
# so trusting every hop lets a client spoof its IP and bypass every IP-keyed
# rate limiter (login, password reset, 2FA).
TRUSTED_PROXIES=
